# Copy to agency-pull/.env to switch versions without editing the compose file.
#
#   develop = old code (polling, no /api/v1/health)
#   sse     = feature/sse (SSE stream + /api/v1/health + metrics)
#
# Images are built locally by `make build-versions`.

API_TAG=develop
WEB_TAG=develop

# prod = Swagger off (matches the deployed API); use "dev" to expose /swagger-ui.html
SPRING_PROFILES_ACTIVE=prod
